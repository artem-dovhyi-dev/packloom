[2.6, "o", "\r\n"]
[2.803, "o", "tech       machines, energy, automation\r\nstorage    digital or bulk storage, pipes, logistics\r\nmagic      spells, mana, rituals\r\nrpg        new dimensions, bosses, gear progression\r\nadventure  structures, dungeons, exploration\r\nfarming    crops, animals, bees, automated farms\r\nfood       cooking and meals\r\nworldgen   biomes and terrain\r\ncoop       teams, shared progress, voice, map\r\nquests     a quest book that leads the player\r\nqol        recipes viewer, tooltips, backpacks, small conveniences\r\nperf       runs faster, no gameplay change\r\nvisual     textures and shaders\r\ntune       lets the pack author change recipes and add items\r\n"]
